# Copy this file to .env and edit before running setup-monitoring.sh.
# The real .env is gitignored.

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Host address Grafana and Prometheus bind to. setup-monitoring.sh overwrites
# this with the output of `tailscale ip -4` on every run.
MON_BIND_ADDR=
